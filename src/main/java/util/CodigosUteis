//aplica a mask em todos com class money type text.. ex:<input type="text"(tem que ser tex e não number) class="form-control money"

$(document).ready(function() {
    // Aplica a máscara nos inputs com a classe "money"
    $(".money").maskMoney({
        prefix: "R$ ",
        allowNegative: false,
        thousands: ".",
        decimal: ",",
        affixesStay: false
    });

    function removerMascara(valor) {
        return valor.replace(/\./g, '').replace(',', '.').replace('R$ ', '').trim();
    }

    // Remove a máscara antes de enviar o formulário
    $("#idForm").on("submit", function(e) {
        $(".money").each(function() {
            var valorSemMascara = removerMascara($(this).val());
            $(this).val(valorSemMascara);
        });
    });
});

