EXIBIR DATAS E QUANTIDADES DE FOTOS DESCONTADAS NO SALARIO


SELECT
    l.nome,
    v.data_venda,
    ABS(COALESCE(v.ribbon_dif::INTEGER, 0)) AS ribbon_descontar
FROM vendas v
INNER JOIN model_login l ON v.vendedor_id = l.id
WHERE v.ribbon = 'DESCONTAR'
  AND v.data_venda BETWEEN TO_DATE('2026-07-01', 'YYYY-MM-DD') AND TO_DATE('2026-07-31', 'YYYY-MM-DD')
ORDER BY v.data_venda ASC;


