-- Table: public.configuracao

-- DROP TABLE IF EXISTS public.configuracao;

CREATE TABLE IF NOT EXISTS public.configuracao
(
    "idConf" integer NOT NULL DEFAULT nextval('configuracao_id_seq'::regclass),
    prod1_valor numeric(10,2),
    prod2_valor numeric(10,2),
    prod3_valor numeric(10,2),
    comissao numeric(10,2),
    prod1_nome character varying(255) COLLATE pg_catalog."default",
    prod2_nome character varying(255) COLLATE pg_catalog."default",
    prod3_nome character varying(255) COLLATE pg_catalog."default",
    CONSTRAINT configuracao_pkey PRIMARY KEY ("idConf")
)

TABLESPACE pg_default;

ALTER TABLE IF EXISTS public.configuracao
    OWNER to postgres;